rules_version = '2';

// Vortex | regras de segurança do Firestore (versão 2: fichas públicas)
// Cole este conteúdo em: Firebase > Firestore Database > Regras > Publicar.
// Pressupõe o login Anônimo ativado (Authentication > Método de login).
// Teste no "Playground de regras" antes de divulgar o site.
//
// Modelo de confiança: o jogo funciona na boa-fé.
//  - Qualquer pessoa logada LÊ e EDITA qualquer ficha.
//  - Só quem criou a ficha (ownerUid) pode EXCLUIR.
//  - Para restringir a edição só ao dono, troque a regra "allow update" de /characters.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function campaignRef(id) {
      return /databases/$(database)/documents/campaigns/$(id);
    }
    function isCampaignOwner(id) {
      return get(campaignRef(id)).data.ownerUid == request.auth.uid;
    }
    function isCampaignMember(id) {
      return request.auth.uid in get(campaignRef(id)).data.memberUids;
    }

    // ---------- Nomes reservados (impede nomes repetidos) ----------
    // Cada nome vira um documento c_nome (personagem/criatura) ou k_nome (campanha).
    // Criar um documento que já existe é uma atualização, e atualização é proibida:
    // por isso dois nomes iguais nunca passam. Como qualquer pessoa pode renomear
    // uma ficha, qualquer pessoa logada também pode apagar uma reserva antiga.
    match /names/{key} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && key.matches('(c|k)_.+')
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.kind in ['character', 'campaign'];
      allow delete: if signedIn();
    }

    // ---------- Perfis (falso login) ----------
    // O ID do documento é o código de 1 a 6 dígitos. Quem sabe o código abre o perfil:
    // não é senha. Listar é proibido, para ninguém varrer os códigos.
    match /profiles/{code} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'chars', 'camps', 'gm', 'favs', 'updatedAt'])
            && d.name is string && d.name.size() <= 40
            && d.chars is list && d.chars.size() <= 300
            && d.camps is list && d.camps.size() <= 300
            && d.gm is list && d.gm.size() <= 300
            && d.favs is list && d.favs.size() <= 300;
      }
      allow get: if signedIn() && code.matches('[0-9]{1,6}');
      allow create, update: if signedIn() && code.matches('[0-9]{1,6}') && validProfile();
    }

    // ---------- Banco de itens (itens, mods, propriedades, acessórios, espécimes, poderes) ----------
    // Público: qualquer pessoa logada vê tudo o que foi registrado; só quem criou edita ou exclui.
    match /library/{entryId} {
      function validEntry() {
        let d = request.resource.data;
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 80
            && d.kind is string && d.kind.size() <= 40
            && (!('image' in d) || d.image.size() <= 150000)
            && (!('thumb' in d) || d.thumb.size() <= 20000);
      }
      allow read: if signedIn();
      allow create: if signedIn() && validEntry() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && validEntry()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Personagens e criaturas: públicos e editáveis ----------
    match /characters/{characterId} {

      // limites para uma ficha válida (protege contra lixo, já que qualquer um edita)
      function validChar() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerUid', 'name', 'nameKey', 'type', 'image', 'thumb', 'species', 'age',
                                 'origin', 'campaignIds', 'searchKeys', 'createdAt', 'updatedAt', 'sheet'])
            && d.type in ['personagem', 'criatura']
            && d.name is string && d.name.size() >= 2 && d.name.size() <= 40
            && d.species.size() <= 40 && d.age.size() <= 20 && d.origin.size() <= 60
            && d.image.size() <= 150000 && d.thumb.size() <= 20000;
      }

      allow read: if signedIn();   // vale para abrir uma ficha e para a busca

      allow create: if signedIn()
                    && validChar()
                    && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
                    && validChar()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.type == resource.data.type;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------- Campanhas ----------
    // O ID do documento é o ID de entrada. Quem tem o ID consegue abrir a campanha;
    // listar só funciona para o mestre ou para quem já participa.
    match /campaigns/{campaignId} {
      allow get: if signedIn();

      allow list: if signedIn()
                  && (resource.data.ownerUid == request.auth.uid
                      || request.auth.uid in resource.data.memberUids);

      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() && (
        // o mestre edita a própria campanha
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        ||
        // qualquer pessoa logada pode entrar ou sair (só mexe em memberUids, e só no próprio uid)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && (
            (request.auth.uid in request.resource.data.memberUids
              && request.resource.data.memberUids.hasAll(resource.data.memberUids)
              && request.resource.data.memberUids.size() <= resource.data.memberUids.size() + 1)
            ||
            (!(request.auth.uid in request.resource.data.memberUids)
              && resource.data.memberUids.hasAll(request.resource.data.memberUids)
              && request.resource.data.memberUids.size() >= resource.data.memberUids.size() - 1)
          ))
      );

      // ---------- Candidatos: só o vínculo (a ficha é lida direto de /characters) ----------
      match /members/{characterId} {
        allow read: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));

        // getAfter: no mesmo lote, a pessoa já precisa constar em memberUids
        allow create: if signedIn()
                      && request.resource.data.ownerUid == request.auth.uid
                      && request.auth.uid in getAfter(campaignRef(campaignId)).data.memberUids;

        // quem participa da campanha (ou o mestre) pode tirar um vínculo
        allow delete: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));
      }

      // ---------- Combate: inimigos do mestre (PV, escudo, blindagem e defesa da cena) ----------
      // Só o mestre coloca ou tira; quem participa pode atualizar (aplicar dano e rolar defesa).
      match /foes/{foeId} {
        allow read: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));
        allow create, delete: if signedIn() && isCampaignOwner(campaignId);
        allow update: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId))
                      && request.resource.data.name == resource.data.name;
      }

      // ---------- Cena (arena): ordem de iniciativa, rodada, turno, condições e quem fica fora ----------
      // O mestre abre e encerra; quem participa pode avançar o turno e entrar na ordem.
      // tags: condições e estados por lutador ({ id: [{ n, r }] }); out: personagens fora do combate.
      // Só o mestre muda quem fica fora; as condições também mudam quando a rodada vira (duração).
      match /scene/{docId} {
        allow read: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));
        allow create, update: if signedIn() && docId == 'state'
                              && (isCampaignMember(campaignId) || isCampaignOwner(campaignId))
                              && request.resource.data.order is list
                              && request.resource.data.order.size() <= 60
                              && (!('tags' in request.resource.data)
                                  || (request.resource.data.tags is map && request.resource.data.tags.size() <= 80))
                              && (!('out' in request.resource.data)
                                  || (request.resource.data.out is list && request.resource.data.out.size() <= 60))
                              && (isCampaignOwner(campaignId)
                                  || request.resource.data.get('out', []) == (resource == null ? [] : resource.data.get('out', [])));
        allow delete: if signedIn() && isCampaignOwner(campaignId);
      }

      // ---------- Lojas: o mestre cria as dele, das companhias e de NPCs; um jogador abre a própria ----------
      // Quem participa atualiza (comprar baixa o estoque; o dono abastece). Tipo e dono não mudam.
      match /shops/{shopId} {
        allow read: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));
        allow create: if signedIn()
                      && request.resource.data.items is list && request.resource.data.items.size() <= 300
                      && (isCampaignOwner(campaignId)
                          || (isCampaignMember(campaignId)
                              && request.resource.data.kind == 'jogador'
                              && request.resource.data.ownerUid == request.auth.uid));
        allow update: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId))
                      && request.resource.data.kind == resource.data.kind
                      && request.resource.data.ownerUid == resource.data.ownerUid
                      && request.resource.data.items is list && request.resource.data.items.size() <= 300;
        allow delete: if signedIn() && (isCampaignOwner(campaignId) || resource.data.ownerUid == request.auth.uid);
      }

      // ---------- Chat de dados (rolagens não podem ser editadas) ----------
      // O mestre também rola (pelos inimigos), mesmo sem personagem na campanha.
      match /rolls/{rollId} {
        allow read: if signedIn() && (isCampaignMember(campaignId) || isCampaignOwner(campaignId));

        allow create: if signedIn()
                      && (isCampaignMember(campaignId) || isCampaignOwner(campaignId))
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.total is int
                      && request.resource.data.expr.size() <= 120
                      && request.resource.data.label.size() <= 60
                      && request.resource.data.detail.size() <= 1500;

        allow delete: if signedIn() && isCampaignOwner(campaignId);
      }
    }
  }
}
